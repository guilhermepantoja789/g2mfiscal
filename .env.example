APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=g2m_fiscal
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# NFS-e Nacional (tpAmb: 1=produção, 2=homologação; vazio = deriva de APP_ENV)
# NFSE_NACIONAL_TP_AMB=2
# Overrides opcionais de URL (deixe vazio para usar o mapa oficial por ambiente):
# NFSE_NACIONAL_URL_SEFIN=
# NFSE_NACIONAL_URL_ADN=
# NFSE_NACIONAL_URL_CONSULTA_API=

# NFC-e (motor nativo — sem sped-nfe/Focus)
FISCAL_NFCE_DRIVER=raw_native
NFCE_ENDPOINT_PROFILE=homolog_nac
NFCE_QRCODE_VERSION=2
NFCE_SOAP_TIMEOUT=60
NFCE_SOAP_CONNECT_TIMEOUT=20
# Prazo de cancelamento NFC-e (minutos após autorização)
NFCE_CANCELAMENTO_PRAZO_MINUTOS=30
# false evita errno 60 (cadeia ICP-Brasil) no Herd/macOS; true + NFCE_SSL_CAFILE em produção
NFCE_SSL_VERIFY=false
# NFCE_SSL_CAFILE=/caminho/para/cacert-icp-brasil.pem

# Financeiro gateway Asaas (cobranças/carteira) — opcional; convive com lançamentos gerenciais ERP
FEATURE_FINANCEIRO=false

# ERP (Documentos/estoque/P&R): habilitado por padrão por empresa.
# Para desligar: registro em empresa_modulos (modulo=erp, ativo=0).
